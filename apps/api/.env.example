# Porta onde a API irá rodar
PORT=3001

# Ambiente da aplicação
# Valores comuns: development, staging, production
NODE_ENV=development

# URL de conexão com o PostgreSQL
# Formato:
# postgresql://usuario:senha@host:porta/nome_do_banco?schema=public
# Exemplo local. Para homologação, solicite o valor real ao Tech Lead.
DATABASE_URL=postgresql://valhalla_app:@localhost:5432/valhalla?schema=public

# Chave secreta usada para autenticação/JWT
# Obrigatória em todos os ambientes de execução; gerar localmente, pelo menos 32 bytes.
# Não versionar o valor gerado. Sem fallback no código.
JWT_SECRET=

# Duração positiva: segundos ou sufixo s/m/h/d. Exemplo seguro de duração, não secret.
JWT_EXPIRES_IN=15m

# URL do front-end
# Usado para CORS, redirects e integrações futuras
FRONTEND_URL=http://localhost:3000

# Configuração de CORS
CORS_ORIGIN=http://localhost:3000
