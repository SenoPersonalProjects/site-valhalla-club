# Porta onde a API irá rodar
PORT=3001

# Ambiente da aplicação
# Valores comuns: development, staging, production
NODE_ENV=development

# URL de conexão com o banco de dados MySQL
# Formato:
# mysql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=mysql://usuario:senha@localhost:3306/valhalla

# Chave secreta usada para autenticação/JWT
# Em ambiente real, trocar por uma chave forte e segura
JWT_SECRET=change-me

# Tempo de expiração do token JWT
JWT_EXPIRES_IN=1d

# URL do front-end
# Usado para CORS, redirects e integrações futuras
FRONTEND_URL=http://localhost:3000

# Configuração de CORS
CORS_ORIGIN=http://localhost:3000